# Variables de entorno de Orgadia.
#
# Copia este archivo como `.env.local` y rellena los valores con los de tu
# proyecto de Supabase (Project Settings → API).
# `.env.local` está ignorado por git: los valores reales nunca se versionan.

# URL del proyecto, por ejemplo https://abcdefghijkl.supabase.co
VITE_SUPABASE_URL=

# Clave pública (publishable / anon key). Es segura en el navegador
# porque el acceso a los datos lo limita RLS, nunca esta clave.
VITE_SUPABASE_PUBLISHABLE_KEY=

# NUNCA pongas aquí la service_role / secret key:
# se salta RLS y no debe existir en el cliente.
